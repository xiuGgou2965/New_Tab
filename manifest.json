{
  "manifest_version": 3,
  "name": "标签页搜索",
  "version": "1.0.0",
  "description": "一个带搜索引擎的新标签页。",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_title": "搜索标签页",
    "default_popup": "popup.html"
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://uapis.cn/*"]
}
